# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environment and Distribution
.env
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/

# Large Datasets & Raw Data (Never commit raw audio/large datasets)
data/raw/*
!data/raw/.gitkeep
data/audio/*
!data/audio/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
*.wav
*.mp3
*.flac
*.ogg
*.amr

# Model Checkpoints & Pretrained Weights
*.pt
*.pth
*.onnx
*.bin
*.npz
checkpoints/
data/cache/

# Node & Frontend
node_modules/
app/frontend/dist/
app/frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets & Credentials
*.key
*.pem
credentials.json
.secrets/
